# Copy to backend/.env for local dev, or set these as environment
# variables in your Railway project settings for production.
#
# DJANGO_DEBUG and DJANGO_ALLOWED_HOSTS default to production-safe values in
# code (DEBUG=False, ALLOWED_HOSTS=the Railway host only) so a missing env
# var in production fails safe. That means local dev MUST set both below via
# backend/.env, or `runserver` will 400 on localhost.

# --- Core Django ---
# Generate a real one for production: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# Comma-separated. Production example: api.blacknadya.com,.up.railway.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated frontend origins allowed to call the API.
# Production example: https://blacknadya.com,https://www.blacknadya.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Leave unset for local SQLite. Railway injects this automatically once a
# Postgres plugin is attached to the service.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Media storage (Cloudflare R2 / S3-compatible) ---
# Set USE_S3=True in production to store uploaded images in R2 instead of
# the local filesystem. Leave unset (or False) for local dev.
USE_S3=False
# AWS_ACCESS_KEY_ID=your-r2-access-key-id
# AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
# AWS_STORAGE_BUCKET_NAME=black-nadya-media
# Account-level endpoint only — do NOT include the bucket name in the host.
# AWS_S3_ENDPOINT_URL=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=media.blacknadya.com
# R2 ignores the actual region but boto3 requires one be set; "auto" is
# Cloudflare's documented value. Only override if you have a reason to.
# AWS_S3_REGION_NAME=auto
